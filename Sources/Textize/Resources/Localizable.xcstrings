    "Allow Textize under System Settings > Privacy & Security > Screen & System Audio Recording (System Audio Recording Only). (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Textize unter Systemeinstellungen > Datenschutz & Sicherheit > Aufnahme von Bildschirm & Systemaudio (Nur Aufnahme von Systemaudio). (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Textize under System Settings > Privacy & Security > Screen & System Audio Recording (System Audio Recording Only). (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Textize en Ajustes del Sistema > Privacidad y seguridad > Grabación de pantalla y del audio del sistema (Solo grabación del audio del sistema). (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Textize dans Réglages Système > Confidentialité et sécurité > Enregistrement de l’écran et des sons du système (Enregistrement des sons du système uniquement). (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > プライバシーとセキュリティ > 画面収録とシステムオーディオ録音(システムオーディオ録音のみ)でTextizeを許可してください。(%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > 화면 및 시스템 오디오 녹음(시스템 오디오 녹음만)에서 Textize를 허용하세요. (%@)"
          }
        }
      }
    },
