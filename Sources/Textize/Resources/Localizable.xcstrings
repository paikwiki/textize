    "Click a sentence to see its original. Esc to exit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Satz, um das Original zu sehen. Esc zum Beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a sentence to see its original. Esc to exit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una frase para ver el original. Esc para salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une phrase pour voir l’original. Échap pour quitter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文をクリックすると原文が表示されます。Escで終了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장을 클릭하면 원문이 보입니다. Esc로 나갑니다."
          }
        }
      }
    },
